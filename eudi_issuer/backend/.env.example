# Server
PORT=4000

# JWT secret for user sessions (change this in production!)
JWT_SECRET=super_secret_change_me_please

# Admin account (created automatically on first run)
ADMIN_EMAIL=admin@eudi.demo
ADMIN_PASSWORD=Admin1234!

# Walt.id issuer API (internal URL — Docker container name or localhost)
WALTID_ISSUER_URL=http://localhost:7002
# Public URL the wallet App (phone) can reach — set to your LAN IP
WALTID_PUBLIC_URL=http://192.168.1.100:7002

# Email (SMTP) — example using Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=EUDI Issuer <your_email@gmail.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
