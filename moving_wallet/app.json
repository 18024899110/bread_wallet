{
  "expo": {
    "name": "EUDI Wallet",
    "slug": "eudi-wallet",
    "version": "1.0.0",
    "scheme": "eudiw",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a56db"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "au.edu.unsw.eudiwallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your wallet",
        "NSCameraUsageDescription": "Scan QR codes to receive credential requests"
      }
    },
    "android": {
      "package": "au.edu.unsw.eudiwallet",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your wallet"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan QR codes to receive credential requests"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
